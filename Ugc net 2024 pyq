  { topic:"Human Geography", q:"Pastoral Nomadism can be identified with: (A) Subsistence activity depending on animals (B) Each community occupies a well-defined territory (C) Animals depend entirely on natural vegetation (D) Mining is an important activity", opts:["B, C & D Only","A, C & D Only","A, B & D Only","A, B & C Only"], ans:3 },
  { topic:"Cartography", q:"Which one of the following map is known as dynamic Map?", opts:["Flow Map","Dot Map","Isopleth","Choropleth"], ans:0 },
